{
  "logLevel": "INFO",
  "pathStorage": "/tmp/sensor-network-collector",
  "influxdb": false,
  "influxdbUrl": "http://localhost:8086",
  "influxdbToken": "replace-with-influx-read-token",
  "influxdbOrg": "replace-with-influx-org",
  "influxdbBucket": "replace-with-influx-bucket",
  "influxMeasurement": "mqtt_data",
  "httpHost": "0.0.0.0",
  "httpPort": 8080,
  "baseUrl": "http://localhost:8080",
  "webAppName": "meteo@uniparthenope Sensor Network",
  "webAppShortName": "network.meteo@uniarthenope",
  "webAppLogo": "",
  "webAppIcon": "",
  "webAppLink": "https://meteo.uniparthenope.it",
  "webInfoLink": "",
  "webThemePrimary": "#1f4e79",
  "webThemeSecondary": "#2a91eb",
  "webThemeAccent": "#181c63",
  "mapTileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
  "mapTileAttribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
  "authDbPath": "/tmp/sensor-network-collector/collector_auth.sqlite",
  "databaseUrl": "",
  "webSessionSecret": "replace-with-a-strong-random-secret",
  "privacyControllerName": "Replace with the legal name of the data controller",
  "privacyControllerContact": "privacy@example.org",
  "privacyDpoContact": "",
  "privacyLawfulBasis": "Replace with the documented Article 6 legal basis and processing purpose",
  "privacyAccountRetentionDays": 365,
  "privacyAuditRetentionDays": 365,
  "adminUser": "admin",
  "adminPassword": "change-me-now",
  "loginRateLimit": 10,
  "loginRateWindowSec": 300,
  "resetRateLimit": 5,
  "resetRateWindowSec": 3600,
  "smtpEnabled": false,
  "smtpHost": "smtp.example.com",
  "smtpPort": 587,
  "smtpUser": "mailer@example.com",
  "smtpPass": "replace-with-smtp-password",
  "smtpFrom": "collector@example.com",
  "smtpUseTls": true,
  "smtpQueueBatchSize": 10,
  "watchdogIntervalSec": 60,
  "signalkPathMap": {
    "SoilMoisture": {
      "meta": {
        "units": "%"
      }
    }
  }
}
